{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,

  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",

  "trailingSlash": true,
  "cleanUrls": false,

  "headers": [
    {
      "//": "قاعدة عامة أولًا. عند تكرار نفس الترويسة تفوز القاعدة الأخيرة المطابقة، لذلك تأتي قواعد التخزين الأدق بعدها.",
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "//": "الصور والخطوط والأيقونات: أسماؤها ثابتة ومحتواها لا يتغيّر، فتُخزَّن سنة كاملة.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(styles.css|script.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/favicon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
